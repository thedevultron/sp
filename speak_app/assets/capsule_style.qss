/* SPEAK — Authkit Frosted Glass Cathedral at Midnight
   Canvas #05060f, frost #d1e4fa, moon #c7d3ea, fog #9da7ba,
   hairline #1FBAD7F7 (rgba 12%), accent Void Violet #663af3 (CTA only).
   Buttons 999px pill, cards/modals 16px, badges/inputs 6px, icon tiles 9999px.
   NOTE: Qt QSS has no backdrop-blur / inset-shadow / conic-gradient.
   Frost is simulated with translucent fills + 1px hairline borders.
   Grid + spotlight halo are painted in code (see BackgroundGridWidget),
   not in QSS, to avoid glitches.
*/

* {
    font-family: "Inter", "Segoe UI Variable Display", "Segoe UI", system-ui, sans-serif;
    color: #D1E4FA;
    font-size: 13px;
}

QMainWindow, QDialog, QWidget#DialogRoot {
    background-color: #05060F;
    border: none;
}

QToolTip {
    background-color: #0B1023;
    color: #D1E4FA;
    border: 1px solid #1FBAD7F7;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ---- Eyebrow labels (dotDigital substitute) ---- */
QLabel#EyebrowLabel {
    font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: #C7D3EA;
    background: transparent;
}

/* ---- Display headings (aeonikPro substitute) ---- */
QLabel#DisplayHeading {
    font-family: "Space Grotesk", "Inter", "Segoe UI", sans-serif;
    font-size: 28px;
    font-weight: 500;
    color: #D8ECF8;
}

/* ---- Tabs: hairline underline, violet active ---- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #1FBAD7F7;
    background-color: transparent;
    margin-top: -1px;
    padding-top: 10px;
}
QTabBar::tab {
    background: transparent;
    color: #9DA7BA;
    padding: 7px 12px;
    margin-right: 6px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #D8ECF8;
    border-bottom: 2px solid #663AF3;
    font-weight: 600;
}
QTabBar::tab:hover:!selected { color: #C7D3EA; }

/* ---- Inputs: 6px radius, luminous fill, frost hairline ---- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #0F1428;
    border: 1px solid #1FBAD7F7;
    border-radius: 6px;
    padding: 8px 12px;
    color: #FFFFFF;
    selection-background-color: #663AF3;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #3D663AF3;
    background-color: #111834;
}
QLineEdit:disabled, QTextEdit:disabled {
    background-color: #0A0D1D;
    color: #9DA7BA;
    border: 1px solid #0FBAD7F7;
}
QLineEdit::placeholder, QTextEdit::placeholder { color: #9DA7BA; }

QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background-color: #0B1023;
    border: 1px solid #1FBAD7F7;
    border-radius: 6px;
    selection-background-color: #241B4D;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

/* ---- Buttons: all pills 999px ---- */
QPushButton {
    background-color: #14BAD6F7;
    border: 1px solid #1FBAD7F7;
    border-radius: 12px;
    padding: 7px 16px;
    font-weight: 500;
    font-size: 13px;
    color: #FFFFFF;
}
QPushButton:hover {
    background-color: #1FBAD7F7;
    border: 1px solid #33BAD7F7;
    color: #FFFFFF;
}
QPushButton:pressed { background-color: #0ABAD6F7; }
QPushButton:disabled {
    background-color: #0A0D1D;
    color: #9DA7BA;
    border: 1px solid #0FBAD7F7;
}

/* Primary CTA — Void Violet ONLY for Save/Continue */
QPushButton#PrimaryButton {
    background-color: #663AF3;
    border: 1px solid #7A52FF;
    color: #FFFFFF;
    font-weight: 600;
    padding: 9px 22px;
    border-radius: 12px;
}
QPushButton#PrimaryButton:hover { background-color: #7550F5; border-color: #8A68FF; }
QPushButton#PrimaryButton:pressed { background-color: #552FD1; }
QPushButton#PrimaryButton:disabled {
    background-color: #1A2038;
    color: #9DA7BA;
    border: 1px solid #0FBAD7F7;
}

/* Secondary ghost */
QPushButton#SecondaryButton {
    background-color: transparent;
    border: 1px solid #1FBAD7F7;
    color: #D1E4FA;
    font-weight: 500;
}
QPushButton#SecondaryButton:hover { background-color: #14BAD6F7; color: #FFFFFF; }
QPushButton#SecondaryButton:pressed { background-color: #0ABAD6F7; }

/* Danger — keep muted red text, frost border */
QPushButton#DangerButton {
    background-color: transparent;
    border: 1px solid #33E46D4C;
    color: #F0A08A;
}
QPushButton#DangerButton:hover {
    background-color: #14E46D4C;
    border-color: #55E46D4C;
    color: #FFFFFF;
}

/* Ghost toolbar */
QPushButton#GhostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #9DA7BA;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}
QPushButton#GhostButton:hover {
    background: #14BAD6F7;
    color: #D1E4FA;
    border: 1px solid #1FBAD7F7;
}

/* ---- Badges / tags 6px ---- */
QLabel#BadgeLabel {
    background-color: #1FC7D3EA;
    border: 1px solid #1FBAD7F7;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
    color: #D1E4FA;
}

/* ---- Lists ---- */
QListWidget {
    background-color: #0A0D1D;
    border: 1px solid #1FBAD7F7;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    color: #D1E4FA;
}
QListWidget::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 7px 10px;
    margin: 1px 0px;
    border: 1px solid transparent;
    color: #C7D3EA;
}
QListWidget::item:hover { background-color: #14BAD6F7; color: #D1E4FA; }
QListWidget::item:selected {
    background-color: #241B4D;
    color: #FFFFFF;
    border: 1px solid #663AF3;
}

/* ---- Sliders: thin track, violet fill ---- */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #1A2340;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #663AF3; border-radius: 2px; }
QSlider::add-page:horizontal { background: #1A2340; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #1FBAD7F7;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    margin-bottom: -6px;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover { background: #D8ECF8; }
QSlider::handle:horizontal:pressed { background: #C7D3EA; }

/* ---- Checkbox ---- */
QCheckBox { spacing: 8px; color: #D1E4FA; padding: 3px 0px; background: transparent; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border: 1px solid #1FBAD7F7;
    border-radius: 6px;
    background-color: #0F1428;
}
QCheckBox::indicator:hover { border: 1px solid #663AF3; }
QCheckBox::indicator:checked {
    background-color: #663AF3;
    border: 1px solid #663AF3;
}
QCheckBox::indicator:checked:hover { background-color: #7550F5; }

/* ---- GroupBox: glass card 16px ---- */
QGroupBox {
    background-color: #08BAD6F7;
    border: 1px solid #1FBAD7F7;
    border-radius: 16px;
    margin-top: 12px;
    padding-top: 16px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    color: #D1E4FA;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #9DA7BA;
    font-weight: 600;
    font-size: 11px;
}

/* ---- Labels ---- */
QLabel { background: transparent; color: #D1E4FA; }

/* ---- Scroll ---- */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical {
    border: none; background: transparent; width: 6px;
    border-radius: 3px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2A3352; border-radius: 3px; min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #3A4568; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal {
    border: none; background: transparent; height: 6px;
    border-radius: 3px; margin: 2px;
}
QScrollBar::handle:horizontal { background: #2A3352; border-radius: 3px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #3A4568; }

/* ---- Progress ---- */
QProgressBar {
    background-color: #0F1428;
    border: none;
    border-radius: 2px;
    text-align: center;
    color: #9DA7BA;
}

/* ---- Capsule specific ---- */
QWidget#CapsulePill { background: transparent; }

/* Capsule custom title bar — close-only chrome */
QWidget#CapsuleTitleBar {
    background: #0ABAD6F7;
    border: 1px solid #1FBAD7F7;
    border-radius: 9px;
}

/* Settings header / model bar / bottom bar */
QFrame#SettingsHeader {
    background-color: #080B1A;
    border: none;
    border-bottom: 1px solid #1FBAD7F7;
}
QFrame#ModelBar {
    background-color: #080B1A;
    border-top: 1px solid #0FBAD7F7;
    border-bottom: 1px solid #0FBAD7F7;
}
QFrame#BottomBar {
    background-color: #080B1A;
    border: none;
    border-top: 1px solid #0FBAD7F7;
}
QFrame#GlassCard {
    background-color: #08BAD6F7;
    border: 1px solid #1FBAD7F7;
    border-radius: 16px;
}
