/* =========================================================================
   SPEAK — Claude Warm Dark Design System (Premium Polished)
   Enhanced for readability, polish, and Windows High-DPI
   ========================================================================= */

* {
    font-family: "Segoe UI Variable Display", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    color: #F3F3EE;
    font-size: 13px;
}

QMainWindow, QDialog, QWidget#DialogRoot {
    background-color: #141416;
    border: 1px solid #28282E;
    border-radius: 12px;
}

/* Window polish */
QDialog {
    background-color: #141416;
}

QToolTip {
    background-color: #1E1E22;
    color: #F3F3EE;
    border: 1px solid #363640;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}

/* Tabs - more premium */
QTabWidget::pane {
    border: 1px solid #28282E;
    border-radius: 8px;
    background-color: #18181B;
    top: -1px;
    padding: 2px;
}

QTabBar::tab {
    background-color: #141416;
    color: #9C9CA8;
    padding: 9px 18px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    border: 1px solid #28282E;
    border-bottom: none;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #18181B;
    color: #DA7756;
    border-bottom: 2px solid #DA7756;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #1D1D21;
    color: #F3F3EE;
}

/* Form Controls */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #101012;
    border: 1px solid #28282E;
    border-radius: 8px;
    padding: 8px 12px;
    color: #F3F3EE;
    selection-background-color: #DA7756;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #DA7756;
    background-color: #141416;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #1A1A1E;
    color: #6B7280;
    border: 1px solid #1F1F23;
}

/* Dropdown polish */
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #1C1C22;
    border: 1px solid #28282E;
    border-radius: 8px;
    selection-background-color: #DA7756;
    padding: 4px;
}

/* Buttons */
QPushButton {
    background-color: #222228;
    border: 1px solid #32323C;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    color: #F3F3EE;
}

QPushButton:hover {
    background-color: #2B2B33;
    border: 1px solid #444452;
}

QPushButton:pressed {
    background-color: #18181C;
}

QPushButton:disabled {
    background-color: #1A1A1E;
    color: #6B7280;
    border: 1px solid #24242A;
}

QPushButton#PrimaryButton {
    background-color: #DA7756;
    border: 1px solid #E0896C;
    color: #FFFFFF;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 8px;
}

QPushButton#PrimaryButton:hover {
    background-color: #C86646;
    border: 1px solid #D47A5A;
}

QPushButton#PrimaryButton:pressed {
    background-color: #B45536;
}

QPushButton#SecondaryButton {
    background-color: #1E1E22;
    border: 1px solid #2E2E36;
    color: #DA7756;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    background-color: #28282F;
    border: 1px solid #363640;
}

QPushButton#DangerButton {
    background-color: #2D1616;
    border: 1px solid #5A2424;
    color: #FF6B6B;
}

QPushButton#DangerButton:hover {
    background-color: #421C1C;
    border: 1px solid #6B2A2A;
}

/* List Widgets */
QListWidget {
    background-color: #101012;
    border: 1px solid #28282E;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    background-color: #18181B;
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 0px;
    border: 1px solid transparent;
}

QListWidget::item:hover {
    background-color: #1E1E24;
    border: 1px solid #2A2A32;
}

QListWidget::item:selected {
    background-color: #26262E;
    color: #DA7756;
    border: 1px solid #DA7756;
    font-weight: 500;
}

/* Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #28282E;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #DA7756;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: #28282E;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #F3F3EE;
    border: 2px solid #DA7756;
    width: 14px;
    height: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #DA7756;
    border: 2px solid #FFFFFF;
}

QSlider::handle:horizontal:pressed {
    background: #B45536;
}

/* Checkboxes */
QCheckBox {
    spacing: 8px;
    color: #F3F3EE;
    padding: 4px 0px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #383843;
    border-radius: 4px;
    background-color: #101012;
}

QCheckBox::indicator:hover {
    border: 1px solid #DA7756;
}

QCheckBox::indicator:checked {
    background-color: #DA7756;
    border: 1px solid #E0896C;
    image: url(none);
}

QCheckBox::indicator:checked:hover {
    background-color: #C86646;
}

/* Labels polish */
QLabel {
    background: transparent;
}

/* Scroll Areas & Scrollbars */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    border: none;
    background: #141416;
    width: 8px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #2E2E36;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #3A3A46;
}

QScrollBar::handle:vertical:pressed {
    background: #DA7756;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #141416;
    height: 8px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #2E2E36;
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background: #3A3A46;
}

/* Progress Bar (token bar fallback) */
QProgressBar {
    background-color: rgba(255,255,255,0.06);
    border: none;
    border-radius: 2px;
    text-align: center;
}

/* GroupBox */
QGroupBox {
    background-color: #18181B;
    border: 1px solid #28282E;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #DA7756;
    font-weight: 600;
}
