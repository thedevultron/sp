{
  "name": "koota",
  "version": "0.6.6",
  "description": "🌎 Performant real-time state management for TypeScript and React",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmndrs/koota"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "react",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "unplugin-inline-functions": "^0.4.2",
    "vitest": "^4.0.13",
    "@config/typescript": "0.1.0",
    "@koota/react": "0.0.1",
    "@koota/core": "0.0.1"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "pnpm --filter @koota/collections build && tsup --tsconfig tsconfig.build.json && node --no-warnings scripts/copy-readme.ts && node --no-warnings scripts/copy-react-files.ts",
    "test": "vitest --environment=jsdom",
    "generate-tests": "node scripts/generate-tests.ts"
  },
  "module": "./dist/index.js"
}